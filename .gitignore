lerna-debug.log*

node_modules
dist
dist-ssr
.tmp/
tmp/
_tmp/
*.local
.env.audio

# Python bytecode
__pycache__/
*.py[cod]

# Rust build artifacts, including custom audit/test caches at any depth
target/
target-*/
.codex-target/
.codex-target-*/
